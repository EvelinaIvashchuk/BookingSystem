@model ErrorViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = L["Error_Generic_Title"].Value;
}

<div class="cr-panel cr-empty mt-4">
    <div class="cr-empty__icon" style="background:#FCEBEB;color:#A32D2D;"><i class="bi bi-exclamation-triangle"></i></div>
    <h2>@L["Error_Generic_Desc"]</h2>
    <p>@L["Error_Generic_Details"]</p>

    @if (Model?.ShowRequestId == true)
    {
        <p class="small"><span class="cr-label d-inline">@L["Error_RequestId"]</span> <code>@Model.RequestId</code></p>
    }

    <div class="d-flex justify-content-center flex-wrap gap-2">
        <a href="/" class="btn btn-primary px-4"><i class="bi bi-house me-1"></i>@L["Common_GoHome"]</a>
        <button type="button" onclick="history.back()" class="btn btn-outline-secondary px-4">@L["Common_GoBack"]</button>
    </div>

    @* Exception details only in development: never expose internals to visitors. *@
    @if (Env.IsDevelopment() && Context.Items["Exception"] != null)
    {
        <div class="alert alert-warning small text-start mt-4 mb-0">@Context.Items["Exception"]?.ToString()</div>
    }
</div>
