@* AI assistant widget. Behaviour: wwwroot/js/chat-widget.js; texts come from SharedResources via data-* attributes. *@
<div id="chat-widget"
     data-greeting="@L["Chat_Greeting"]"
     data-error="@L["Chat_Error"]"
     data-thinking="@L["Chat_Thinking"]"
     data-per-day="@L["Chat_PerDay"]"
     data-details="@L["Chat_Details"]"
     data-select="@L["Chat_Select"]"
     data-select-message="@L["Chat_SelectMessage"]"
     data-draft-title="@L["Chat_DraftTitle"]"
     data-draft-dates="@L["Chat_DraftDates"]"
     data-draft-total="@L["Chat_DraftTotal"]"
     data-draft-hint="@L["Chat_DraftExpiresHint"]"
     data-confirm="@L["Chat_Confirm"]"
     data-cancel="@L["Chat_Cancel"]"
     data-sign-in="@L["Chat_SignInRequired"]"
     data-my-rentals="@L["Chat_MyRentals"]"
     data-dates-title="@L["Chat_DatesTitle"]"
     data-pickup-date="@L["Chat_PickupDate"]"
     data-return-date="@L["Chat_ReturnDate"]"
     data-dates-send="@L["Chat_DatesSend"]"
     data-dates-both="@L["Chat_DatesBoth"]"
     data-dates-pickup="@L["Chat_DatesPickup"]"
     data-dates-return="@L["Chat_DatesReturn"]"
     data-dates-invalid="@L["Chat_DatesInvalid"]"
     data-chips-start="@L["Chat_ChipsStart"]"
     data-chips-cars="@L["Chat_ChipsCars"]"
     data-chips-draft="@L["Chat_ChipsDraft"]"
     data-chips-booked="@L["Chat_ChipsBooked"]"
     data-mic-start="@L["Chat_MicStart"]"
     data-mic-stop="@L["Chat_MicStop"]"
     data-mic-denied="@L["Chat_MicDenied"]"
     data-mic-error="@L["Chat_MicError"]"
     data-copy="@L["Chat_Copy"]"
     data-copied="@L["Chat_Copied"]">

    @* Token for Confirm/Cancel; sent in the RequestVerificationToken header. *@
    @Html.AntiForgeryToken()

    <button id="chat-toggle" type="button" title="@L["Chat_Title"]" aria-label="@L["Chat_AriaOpen"]" aria-expanded="false" aria-controls="chat-window">
        <i class="bi bi-chat-dots-fill" id="chat-icon-open" aria-hidden="true"></i>
        <i class="bi bi-x-lg d-none" id="chat-icon-close" aria-hidden="true"></i>
    </button>

    <div id="chat-window" class="d-none" role="dialog" aria-label="@L["Chat_Title"]">
        <div id="chat-header">
            <i class="bi bi-robot me-2" aria-hidden="true"></i>
            <span class="flex-grow-1">@L["Chat_Title"]</span>
            <button id="chat-new" type="button" title="@L["Chat_NewChat"]" aria-label="@L["Chat_NewChat"]">
                <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
            </button>
            @* On phones the chat is full-screen and covers the round toggle, so it gets its own close button. *@
            <button id="chat-close" type="button" class="d-sm-none" title="@L["Chat_Close"]" aria-label="@L["Chat_Close"]">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>
        <div id="chat-messages" aria-live="polite"></div>
        <div id="chat-input-area">
            <textarea id="chat-input" rows="1" placeholder="@L["Chat_Placeholder"]" autocomplete="off" maxlength="1000"
                      aria-label="@L["Chat_Placeholder"]"></textarea>
            @* Voice input (Web Speech API); shown by chat-widget.js only where the browser supports it. *@
            <button id="chat-mic" type="button" class="d-none" title="@L["Chat_MicStart"]" aria-label="@L["Chat_MicStart"]" aria-pressed="false">
                <i class="bi bi-mic-fill" aria-hidden="true"></i>
            </button>
            <button id="chat-send" type="button" title="@L["Chat_Send"]" aria-label="@L["Chat_Send"]">
                <i class="bi bi-send-fill" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</div>

<script src="~/js/chat-widget.js" asp-append-version="true"></script>
