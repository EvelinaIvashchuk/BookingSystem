@using BookingSystem.Helpers
@model Rental
@{
    ViewData["Title"] = L["Rental_DetailsHeader"].Value + ": " + Model.Car?.FullName;
    var stage = Model.GetStage(DateTime.UtcNow.Date);
    var closed = stage is RentalStage.Cancelled or RentalStage.Rejected;
    // Stages after "submitted", in order; a step is done once the rental has reached it.
    var steps = new (RentalStage Stage, string Key)[]
    {
        (RentalStage.Confirmed, "Status_Confirmed"), (RentalStage.Active, "Status_Active"), (RentalStage.Completed, "Status_Completed")
    };
}

<div class="cr-page">
    <nav class="cr-crumbs" aria-label="breadcrumb">
        <a asp-action="MyRentals">@L["Rental_MyRentals"]</a><i class="bi bi-chevron-right"></i>
        <span>@L["Rental_Details"] #@Model.Id</span>
    </nav>
    <div class="cr-page-head">
        <div>
            <h1>@Model.Car?.FullName</h1>
            <p>@L["Rental_SubmittedOn"] @Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")</p>
        </div>
        <partial name="_RentalStatusBadge" model="Model" />
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            @* Progress: submitted → confirmed → in progress → completed (or cancelled / rejected) *@
            <div class="cr-panel">
                <div class="cr-steps-line">
                    <div class="cr-steps-line__item is-done"><span><i class="bi bi-check"></i></span>@L["Status_Pending"]</div>
                    @if (closed)
                    {
                        <div class="cr-steps-line__bar is-failed"></div>
                        <div class="cr-steps-line__item is-failed"><span><i class="bi bi-x"></i></span>@(stage == RentalStage.Rejected ? L["Status_Rejected"] : L["Status_Cancelled"])</div>
                    }
                    else
                    {
                        for (var i = 0; i < steps.Length; i++)
                        {
                            var done = stage >= steps[i].Stage;
                            <div class="cr-steps-line__bar @(done ? "is-done" : "")"></div>
                            <div class="cr-steps-line__item @(done ? "is-done" : "")"><span>@if (done) { <i class="bi bi-check"></i> } else { @(i + 2) }</span>@L[steps[i].Key]</div>
                        }
                    }
                </div>
            </div>

            <div class="cr-panel">
                <h2 class="cr-panel__title"><i class="bi bi-calendar-range"></i>@L["Rental_RentalPeriod"]</h2>
                <div class="cr-kv">
                    <div><span class="cr-label">@L["Rental_PickupDate"]</span><div class="cr-kv__value">@Model.PickupDate?.ToString("dddd, dd MMM yyyy")</div></div>
                    <div><span class="cr-label">@L["Rental_ReturnDate"]</span><div class="cr-kv__value">@Model.ReturnDate?.ToString("dddd, dd MMM yyyy")</div></div>
                    @if (Model.DurationDays.HasValue)
                    {
                        <div><span class="cr-label">@L["Rental_Duration"]</span><div class="cr-kv__value">@Model.DurationDays @L["Rental_Days"]</div></div>
                    }
                </div>
                <hr class="cr-divider" />
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span class="cr-muted fw-semibold">@L["Rental_TotalLabel"]</span>
                    <span class="cr-price-big">@Model.TotalPrice.ToString("N0") ₴</span>
                </div>
            </div>

            <div class="cr-panel">
                <h2 class="cr-panel__title"><i class="bi bi-chat-left-text"></i>@L["Rental_Notes"]</h2>
                <p class="mb-0 @(string.IsNullOrEmpty(Model.Notes) ? "cr-muted" : "")">@(string.IsNullOrEmpty(Model.Notes) ? L["Rental_NoNotes"].Value : Model.Notes)</p>
                @if (!string.IsNullOrEmpty(Model.AdminNote))
                {
                    <div class="cr-note mt-3 align-items-start">
                        <i class="bi bi-person-badge"></i>
                        <div><span class="cr-label mb-1">@L["Rental_AdminNote"]</span><span class="fw-normal">@Model.AdminNote</span></div>
                    </div>
                }
                @if (Model.CancelledAt.HasValue)
                {
                    <div class="cr-muted small mt-3"><i class="bi bi-clock-history me-1"></i>@L["Rental_CancelledOn"] @Model.CancelledAt.Value.ToString("dd MMM yyyy, HH:mm")</div>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="cr-panel cr-panel--flush">
                @if (!string.IsNullOrEmpty(Model.Car?.ImageUrl))
                {
                    <img src="@ImageHelper.Src(Model.Car.ImageUrl)" alt="@Model.Car.FullName" class="w-100" style="height: 190px; object-fit: cover;" />
                }
                <div class="p-4">
                    <span class="cr-car__cat">@Model.Car?.Category?.Name</span>
                    <h2 class="h5 fw-bold mt-2 mb-1">@Model.Car?.FullName</h2>
                    <div class="cr-muted small mb-3"><i class="bi bi-geo-alt me-1"></i>@Model.Car?.Location</div>
                    <a asp-controller="Car" asp-action="Details" asp-route-id="@Model.CarId" class="btn btn-outline-primary btn-sm">@L["Home_ViewDetails"]</a>
                </div>
            </div>

            <div class="d-grid gap-2 mt-3">
                @if (Model.CanBeCancelledByUser)
                {
                    <form asp-controller="Rental" asp-action="Cancel" method="post" class="d-grid" onsubmit="return confirm('@L["Rental_CancelConfirm"]');">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-outline-danger"><i class="bi bi-x-circle me-1"></i>@L["Rental_CancelRental"]</button>
                    </form>
                }
                <a asp-action="MyRentals" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>@L["Rental_BackToMyRentals"]</a>
            </div>
        </div>
    </div>
</div>
