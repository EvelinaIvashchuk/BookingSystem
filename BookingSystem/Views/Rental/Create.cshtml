@using BookingSystem.Helpers
@model RentalCreateViewModel
@{
    ViewData["Title"] = L["Car_RentNow"].Value + " " + Model.CarName;
}

<div class="cr-page">
    <nav class="cr-crumbs" aria-label="breadcrumb">
        <a asp-controller="Car" asp-action="Index">@L["Nav_Cars"]</a><i class="bi bi-chevron-right"></i>
        <a asp-controller="Car" asp-action="Details" asp-route-id="@Model.CarId">@Model.CarName</a><i class="bi bi-chevron-right"></i>
        <span>@L["Rental_RentACar"]</span>
    </nav>
    <div class="cr-page-head">
        <div>
            <h1>@L["Rental_RentACar"]</h1>
            <p>@L["Rental_PickupHint"]</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7 order-2 order-lg-1">
            <form asp-action="Create" method="post" class="cr-panel needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>
                <input type="hidden" asp-for="CarId" />
                <input type="hidden" asp-for="CarName" />
                <input type="hidden" asp-for="Location" />
                <input type="hidden" asp-for="PricePerDay" />
                <input type="hidden" asp-for="CategoryName" />
                <input type="hidden" asp-for="ImageUrl" />

                <h2 class="cr-panel__title"><i class="bi bi-calendar-range"></i>@L["Rental_RentalPeriod"]</h2>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label asp-for="PickupDate" class="form-label"></label>
                        <input asp-for="PickupDate" class="form-control form-control-lg" type="date" />
                        <span asp-validation-for="PickupDate" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="ReturnDate" class="form-label"></label>
                        <input asp-for="ReturnDate" class="form-control form-control-lg" type="date" />
                        <span asp-validation-for="ReturnDate" class="text-danger small"></span>
                    </div>
                </div>

                <div class="cr-note mt-3" id="priceEstimateBox">
                    <i class="bi bi-calculator"></i><span id="priceEstimate">&nbsp;</span>
                </div>

                <div class="mt-4">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="3" placeholder="@L["Rental_NotesPlaceholder"]"></textarea>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>

                <div class="cr-form-actions">
                    <a asp-controller="Car" asp-action="Details" asp-route-id="@Model.CarId" class="btn btn-outline-secondary px-4">@L["Rental_Cancel"]</a>
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-send me-1"></i>@L["Rental_SubmitRequest"]</button>
                </div>
            </form>
        </div>

        <div class="col-lg-5 order-1 order-lg-2">
            <div class="cr-panel cr-panel--flush">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@ImageHelper.Src(Model.ImageUrl)" alt="@Model.CarName" class="w-100" style="height: 220px; object-fit: cover;" />
                }
                <div class="p-4">
                    <span class="cr-car__cat">@Model.CategoryName</span>
                    <h2 class="h4 fw-bold mt-2 mb-1">@Model.CarName</h2>
                    <div class="cr-muted mb-3"><i class="bi bi-geo-alt me-1"></i>@Model.Location</div>
                    <div class="cr-price-big">@Model.PricePerDay.ToString("N0") ₴ <small>@L["Car_PerDayShort"]</small></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        window.addEventListener('load', () => {
            const pickupInput = document.querySelector('input[name="PickupDate"]');
            const returnInput = document.querySelector('input[name="ReturnDate"]');

            // If dates were NOT pre-filled from the calendar, set sensible defaults
            if (!pickupInput.value) {
                const today = new Date();
                const tomorrow = new Date(today);
                tomorrow.setDate(tomorrow.getDate() + 1);
                const dayAfter = new Date(tomorrow);
                dayAfter.setDate(dayAfter.getDate() + 3);
                pickupInput.value = tomorrow.toISOString().slice(0, 10);
                returnInput.value = dayAfter.toISOString().slice(0, 10);
            }

            // Live price estimate
            const pricePerDay = parseFloat('@Model.PricePerDay.ToString(System.Globalization.CultureInfo.InvariantCulture)');
            const estimateEl  = document.getElementById('priceEstimate');
            const estimateBox = document.getElementById('priceEstimateBox');
            function updateEstimate() {
                const p = new Date(pickupInput.value);
                const r = new Date(returnInput.value);
                if (isNaN(p) || isNaN(r) || r <= p) { estimateEl.textContent = ''; estimateBox.classList.add('d-none'); return; }
                const days  = Math.round((r - p) / 86400000);
                const total = (days * pricePerDay).toLocaleString('uk-UA');
                estimateEl.textContent = `${days} @Html.Raw(L["Car_DaysSuffix"].Value) · @Html.Raw(L["Car_TotalLabel"].Value) ${total} ₴`;
                estimateBox.classList.remove('d-none');
            }
            pickupInput.addEventListener('change', updateEstimate);
            returnInput.addEventListener('change', updateEstimate);
            updateEstimate();
        });
    </script>
}
