@using BookingSystem.Helpers
@model PaginatedList<Rental>
@{
    ViewData["Title"] = L["Rental_MyRentals"].Value;
}

<div class="cr-page">
    <div class="cr-page-head">
        <div>
            <h1>@L["Rental_MyRentals"]</h1>
            <p>@string.Format(L["Rental_RentalsTotal"].Value, Model.TotalCount)</p>
        </div>
        <a asp-controller="Car" asp-action="Index" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>@L["Rental_RentAnother"]</a>
    </div>

    @if (!Model.Any())
    {
        <div class="cr-panel cr-empty">
            <div class="cr-empty__icon"><i class="bi bi-calendar2-week"></i></div>
            <h2>@L["Rental_NoPrevious"]</h2>
            <p>@L["Home_AiSubtitle"]</p>
            <a asp-controller="Car" asp-action="Index" class="btn btn-primary">@L["Home_BrowseCars"]</a>
        </div>
    }
    else
    {
        <div class="cr-panel cr-panel--flush">
            <table class="cr-table">
                <thead>
                    <tr>
                        <th>@L["Admin_Car"]</th>
                        <th>@L["Rental_Dates"]</th>
                        <th>@L["Rental_Total"]</th>
                        <th>@L["Admin_Status"]</th>
                        <th class="text-end">@L["Common_Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="cr-td-main">
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrEmpty(r.Car?.ImageUrl))
                                    {
                                        <img src="@ImageHelper.Src(r.Car.ImageUrl)" alt="" class="rounded-3" style="width: 64px; height: 44px; object-fit: cover;" />
                                    }
                                    <div>
                                        <div class="cr-td-title">@r.Car?.FullName</div>
                                        <div class="cr-td-sub">@r.Car?.Location</div>
                                    </div>
                                </div>
                            </td>
                            <td data-label="@L["Rental_Dates"]">
                                <div>@r.PickupDate?.ToString("dd MMM") – @r.ReturnDate?.ToString("dd MMM yyyy")</div>
                                <div class="cr-td-sub">@r.DurationDays @L["Rental_Days"]</div>
                            </td>
                            <td data-label="@L["Rental_Total"]" class="fw-bold">@r.TotalPrice.ToString("N0") ₴</td>
                            <td data-label="@L["Admin_Status"]"><partial name="_RentalStatusBadge" model="r.Status" /></td>
                            <td class="cr-td-actions">
                                <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">@L["Rental_Details"]</a>
                                @if (r.CanBeCancelledByUser)
                                {
                                    <form asp-action="Cancel" method="post" class="d-inline" onsubmit="return confirm('@L["Rental_CancelConfirm"]');">
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">@L["Common_Cancel"]</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @{
        ViewData["PageIndex"]   = Model.PageIndex;
        ViewData["TotalPages"]  = Model.TotalPages;
        ViewData["Action"]      = "MyRentals";
        ViewData["RouteValues"] = new Dictionary<string, string>();
    }
    <partial name="_Pagination" />
</div>
