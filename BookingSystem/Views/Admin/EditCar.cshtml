@model CarFormViewModel
@{
    ViewData["Title"] = L["Admin_EditCar_Title"].Value + ": " + Model.Brand + " " + Model.Model;
    ViewData["IsEdit"] = true;
}

<div class="cr-page">
    <partial name="_AdminNav" />
    <nav class="cr-crumbs" aria-label="breadcrumb">
        <a asp-action="Cars">@L["Admin_Cars"]</a><i class="bi bi-chevron-right"></i>
        <span>@L["Admin_Edit_Breadcrumb"]</span>
    </nav>
    <div class="cr-page-head">
        <div>
            <h1>@L["Admin_EditCar_Title"]</h1>
            @if (true) { <p>@Model.Brand @Model.Model · @Model.LicensePlate</p> }
        </div>
    </div>

    <form asp-action="EditCar" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <partial name="_CarFormFields" model="Model" view-data="ViewData" />
        <div class="cr-form-actions">
            <a asp-action="Cars" class="btn btn-outline-secondary px-4">@L["Admin_Cancel"]</a>
            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i>@L["Admin_UpdateCar"]</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('imageFileInput').addEventListener('change', function () {
            const file = this.files[0];
            if (!file) return;
            const img = document.getElementById('previewImg');
            img.src = URL.createObjectURL(file);
            img.classList.remove('d-none');
            document.getElementById('uploadPlaceholder').classList.add('d-none');
        });
    </script>
}
