@model AdminRejectViewModel
@{
    ViewData["Title"] = L["Admin_RejectRental_Title"].Value;
}

<div class="cr-page">
    <partial name="_AdminNav" />
    <nav class="cr-crumbs" aria-label="breadcrumb">
        <a asp-action="Rentals">@L["Admin_RentalsNav"]</a><i class="bi bi-chevron-right"></i>
        <span>@L["Admin_RejectRentalHeader"]</span>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <form asp-action="RejectRental" method="post" class="cr-panel">
                <h1 class="cr-panel__title fs-4"><i class="bi bi-x-circle" style="color:#A32D2D;"></i>@L["Admin_RejectRentalHeader"]</h1>
                <div class="cr-note mb-4" style="background:#FAEEDA;color:#633806;">
                    <i class="bi bi-info-circle"></i>
                    <span class="fw-normal">@L["Admin_RejectAboutTo"] <strong>@Model.CarName</strong> @L["Admin_RejectBy"] <strong>@Model.UserFullName</strong>.</span>
                </div>

                <input type="hidden" asp-for="RentalId" />
                <input type="hidden" asp-for="CarName" />
                <input type="hidden" asp-for="UserFullName" />

                <label asp-for="AdminNote" class="form-label">@L["Admin_ReasonForRejection"]</label>
                <textarea asp-for="AdminNote" class="form-control" rows="4" placeholder="@L["Admin_RejectPlaceholder"]"></textarea>
                <span asp-validation-for="AdminNote" class="text-danger small"></span>

                <div class="cr-form-actions">
                    <a asp-action="Rentals" class="btn btn-outline-secondary px-4">@L["Admin_Cancel"]</a>
                    <button type="submit" class="btn btn-danger px-4">@L["Admin_RejectRequest"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
