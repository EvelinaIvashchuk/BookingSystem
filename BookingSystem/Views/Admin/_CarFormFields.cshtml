@using Microsoft.AspNetCore.Mvc.Rendering
@model CarFormViewModel
@{
    var isEdit = ViewData["IsEdit"] as bool? == true;
    var fuels = Enum.GetValues<FuelType>().Select(v => new SelectListItem(L["Enum_" + v].Value, ((int)v).ToString(), v == Model.FuelType));
    var transmissions = Enum.GetValues<Transmission>().Select(v => new SelectListItem(L["Enum_" + v].Value, ((int)v).ToString(), v == Model.Transmission));
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="cr-panel">
            <h2 class="cr-panel__title"><i class="bi bi-car-front"></i>@L["Admin_SectionMain"]</h2>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Brand" class="form-label"></label>
                    <input asp-for="Brand" class="form-control" placeholder="Toyota" />
                    <span asp-validation-for="Brand" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Model" class="form-label"></label>
                    <input asp-for="Model" class="form-control" placeholder="Camry" />
                    <span asp-validation-for="Model" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Year" class="form-label"></label>
                    <input asp-for="Year" class="form-control" type="number" min="1990" max="2030" />
                    <span asp-validation-for="Year" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="LicensePlate" class="form-label"></label>
                    <input asp-for="LicensePlate" class="form-control" placeholder="AA1234BB" />
                    <span asp-validation-for="LicensePlate" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CategoryId" class="form-label"></label>
                    <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                        <option value="">@L["Admin_SelectCategory"]</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="PricePerDay" class="form-label"></label>
                    <input asp-for="PricePerDay" class="form-control" type="number" step="0.01" min="0.01" />
                    <span asp-validation-for="PricePerDay" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="cr-panel">
            <h2 class="cr-panel__title"><i class="bi bi-sliders"></i>@L["Admin_SectionSpecs"]</h2>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="FuelType" class="form-label"></label>
                    <select asp-for="FuelType" asp-items="fuels" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Transmission" class="form-label"></label>
                    <select asp-for="Transmission" asp-items="transmissions" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Seats" class="form-label"></label>
                    <input asp-for="Seats" class="form-control" type="number" min="1" max="50" />
                    <span asp-validation-for="Seats" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" placeholder="@L["Admin_PhLocation"]" />
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="@L["Admin_PhDescription"]"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                @if (isEdit)
                {
                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="@CarStatus.Available">@L["Admin_Status_Available"]</option>
                            <option value="@CarStatus.Rented">@L["Admin_Status_Rented"]</option>
                            <option value="@CarStatus.UnderMaintenance">@L["Admin_Status_UnderMaintenance"]</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="cr-panel cr-sticky-lg">
            <h2 class="cr-panel__title"><i class="bi bi-image"></i>@L["Admin_SectionPhoto"]</h2>
            @if (isEdit)
            {
                <input type="hidden" asp-for="ImageUrl" />
            }
            <label for="imageFileInput" class="cr-upload">
                <img id="previewImg" src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "" : ImageHelper.Src(Model.ImageUrl))" alt="" class="@(string.IsNullOrEmpty(Model.ImageUrl) ? "d-none" : "")" />
                <span id="uploadPlaceholder" class="cr-upload__empty @(string.IsNullOrEmpty(Model.ImageUrl) ? "" : "d-none")">
                    <i class="bi bi-cloud-arrow-up"></i>@L["Admin_ChoosePhoto"]
                </span>
            </label>
            <input asp-for="ImageFile" type="file" accept="image/jpeg,image/png,image/webp" class="form-control mt-3" id="imageFileInput" />
            <div class="form-text">@L["Admin_ImageHint"]@(isEdit ? " · " + L["Admin_ImageKeepHint"].Value : "")</div>
            <span asp-validation-for="ImageFile" class="text-danger small"></span>
        </div>
    </div>
</div>
