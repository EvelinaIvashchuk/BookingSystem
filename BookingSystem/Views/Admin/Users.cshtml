@model IEnumerable<(BookingSystem.Models.ApplicationUser User, IList<string> Roles)>
@using System.Security.Claims
@{
    ViewData["Title"] = L["Admin_ManageUsers_Title"].Value;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="cr-page">
    <partial name="_AdminNav" />
    <div class="cr-page-head">
        <div>
            <h1>@L["Admin_ManageUsers_Title"]</h1>
            <p>@L["Admin_ManageUsersDesc"]</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="cr-panel cr-empty">
            <div class="cr-empty__icon"><i class="bi bi-people"></i></div>
            <p class="mb-0">@L["Admin_NoUsers"]</p>
        </div>
    }
    else
    {
        <div class="cr-panel cr-panel--flush">
            <table class="cr-table">
                <thead>
                    <tr>
                        <th>@L["Admin_User"]</th>
                        <th>@L["Account_Email"]</th>
                        <th>@L["Admin_Role"]</th>
                        <th>@L["Admin_Registered"]</th>
                        <th>@L["Admin_Status"]</th>
                        <th class="text-end">@L["Admin_Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (user, roles) in Model)
                    {
                        var isSelf = user.Id == currentUserId;
                        var isAdmin = roles.Contains("Admin");
                        var initials = string.Concat((user.FullName ?? user.Email ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
                        <tr class="@(!user.IsActive ? "opacity-75" : "")">
                            <td class="cr-td-main">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="cr-avatar">@initials</span>
                                    <div>
                                        <div class="cr-td-title">@user.FullName @if (isSelf) { <span class="cr-status cr-status--info ms-1">@L["Admin_You"]</span> }</div>
                                        <div class="cr-td-sub">ID: @user.Id[..8]…</div>
                                    </div>
                                </div>
                            </td>
                            <td data-label="@L["Account_Email"]">@user.Email</td>
                            <td data-label="@L["Admin_Role"]">
                                @foreach (var role in roles)
                                {
                                    <span class="cr-status @(role == "Admin" ? "cr-status--info" : "cr-status--neutral") me-1">@L["Role_" + role]</span>
                                }
                            </td>
                            <td data-label="@L["Admin_Registered"]" class="cr-muted">@user.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td data-label="@L["Admin_Status"]">
                                @if (user.IsActive)
                                {
                                    <span class="cr-status cr-status--active"><i class="bi bi-check-circle"></i>@L["Admin_Active"]</span>
                                }
                                else
                                {
                                    <span class="cr-status cr-status--inactive"><i class="bi bi-dash-circle"></i>@L["Admin_Inactive"]</span>
                                }
                            </td>
                            <td class="cr-td-actions">
                                @if (isSelf)
                                {
                                    <span class="cr-muted">—</span>
                                }
                                else
                                {
                                    <form asp-action="ToggleUserActive" method="post" class="d-inline">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <input type="hidden" name="isActive" value="@(!user.IsActive)" />
                                        @if (user.IsActive)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" onclick="return confirm(this.dataset.confirm)"
                                                    data-confirm="@string.Format(L["Admin_ConfirmDeactivate"].Value, user.FullName)">
                                                <i class="bi bi-person-slash me-1"></i>@L["Admin_Deactivate"]
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-person-check me-1"></i>@L["Admin_Activate"]</button>
                                        }
                                    </form>
                                    @if (!isAdmin)
                                    {
                                        <form asp-action="PromoteToAdmin" method="post" class="d-inline">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary" onclick="return confirm(this.dataset.confirm)"
                                                    data-confirm="@string.Format(L["Admin_ConfirmPromote"].Value, user.FullName)">
                                                <i class="bi bi-shield-plus me-1"></i>@L["Admin_MakeAdmin"]
                                            </button>
                                        </form>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
