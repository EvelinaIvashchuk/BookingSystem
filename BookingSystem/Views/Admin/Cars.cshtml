@model IEnumerable<Car>
@{
    ViewData["Title"] = L["Admin_ManageCars_Title"].Value;
    var statuses = new[] { (CarStatus.Available, "Admin_Status_Available"), (CarStatus.Rented, "Admin_Status_Rented"), (CarStatus.UnderMaintenance, "Admin_Status_UnderMaintenance") };
}

<div class="cr-page">
    <partial name="_AdminNav" />
    <div class="cr-page-head">
        <div>
            <h1>@L["Admin_ManageCars_Title"]</h1>
            <p>@L["Admin_ManageCarsDesc"]</p>
        </div>
        <a asp-action="CreateCar" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>@L["Admin_AddNewCar"]</a>
    </div>

    @if (!Model.Any())
    {
        <div class="cr-panel cr-empty">
            <div class="cr-empty__icon"><i class="bi bi-car-front"></i></div>
            <h2>@L["Admin_NoCars"]</h2>
            <a asp-action="CreateCar" class="btn btn-primary mt-2">@L["Admin_AddFirstCar"]</a>
        </div>
    }
    else
    {
        <div class="cr-panel cr-panel--flush">
            <table class="cr-table">
                <thead>
                    <tr>
                        <th>@L["Admin_Car"]</th>
                        <th>@L["Admin_Category"]</th>
                        <th>@L["Admin_PriceDay"]</th>
                        <th>@L["Admin_Seats"]</th>
                        <th>@L["Admin_Status"]</th>
                        <th class="text-end">@L["Admin_Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="cr-td-main">
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrEmpty(c.ImageUrl))
                                    {
                                        <img src="@ImageHelper.Src(c.ImageUrl)" alt="" class="rounded-3 flex-shrink-0" style="width: 64px; height: 44px; object-fit: cover;" loading="lazy" />
                                    }
                                    <div>
                                        <div class="cr-td-title">@c.FullName</div>
                                        <div class="cr-td-sub">@c.LicensePlate · @c.Location.Split(',')[0]</div>
                                    </div>
                                </div>
                            </td>
                            <td data-label="@L["Admin_Category"]"><span class="cr-car__cat">@c.Category?.Name</span></td>
                            <td data-label="@L["Admin_PriceDay"]" class="fw-bold">@c.PricePerDay.ToString("N0") ₴</td>
                            <td data-label="@L["Admin_Seats"]">@c.Seats</td>
                            <td data-label="@L["Admin_Status"]"><partial name="_CarStatusBadge" model="c.Status" /></td>
                            <td class="cr-td-actions">
                                <a asp-action="EditCar" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary btn-icon" title="@L["Admin_Edit"]" aria-label="@L["Admin_Edit"]"><i class="bi bi-pencil"></i></a>
                                <div class="dropdown d-inline-block">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">@L["Admin_Status"]</button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        @foreach (var (status, key) in statuses)
                                        {
                                            <li>
                                                <form asp-action="SetCarStatus" method="post">
                                                    <input type="hidden" name="carId" value="@c.Id" />
                                                    <input type="hidden" name="status" value="@status" />
                                                    <button type="submit" class="dropdown-item @(c.Status == status ? "disabled" : "")">@L[key]</button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
