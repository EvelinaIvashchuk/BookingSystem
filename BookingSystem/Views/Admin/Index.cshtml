@model AdminDashboardViewModel
@{
    ViewData["Title"] = L["Admin_Dashboard_Title"].Value;
}

<div class="cr-page">
    <partial name="_AdminNav" />
    <div class="cr-page-head">
        <div>
            <h1>@L["Admin_DashboardOverview"]</h1>
            <p>@DateTime.Now.ToString("dddd, d MMMM yyyy")</p>
        </div>
        <a asp-action="CreateCar" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>@L["Admin_AddNewCar"]</a>
    </div>

    <div class="cr-stats">
        <div class="cr-stat"><div class="cr-stat__icon"><i class="bi bi-car-front"></i></div><div><div class="cr-stat__value">@Model.TotalCars</div><div class="cr-stat__label">@L["Admin_TotalCars"]</div></div></div>
        <div class="cr-stat"><div class="cr-stat__icon" style="background:#EAF3DE;color:#3B6D11;"><i class="bi bi-check-circle"></i></div><div><div class="cr-stat__value">@Model.AvailableCars</div><div class="cr-stat__label">@L["Admin_AvailableNow"]</div></div></div>
        <div class="cr-stat"><div class="cr-stat__icon" style="background:#FAEEDA;color:#854F0B;"><i class="bi bi-hourglass-split"></i></div><div><div class="cr-stat__value">@Model.PendingRentals</div><div class="cr-stat__label">@L["Admin_PendingRequests"]</div></div></div>
        <div class="cr-stat"><div class="cr-stat__icon"><i class="bi bi-key"></i></div><div><div class="cr-stat__value">@Model.TodaysRentals</div><div class="cr-stat__label">@L["Admin_PickupsToday"]</div></div></div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="cr-panel cr-panel--flush">
                <div class="d-flex justify-content-between align-items-center px-4 pt-4 pb-3">
                    <h2 class="cr-panel__title mb-0"><i class="bi bi-hourglass-split"></i>@L["Admin_RecentPending"]</h2>
                    <a asp-action="Rentals" asp-route-status="Pending" class="btn btn-sm btn-outline-primary">@L["Admin_ViewAll"]</a>
                </div>
                @if (!Model.RecentPending.Any())
                {
                    <div class="cr-empty pt-2">
                        <div class="cr-empty__icon"><i class="bi bi-inbox"></i></div>
                        <p class="mb-0">@L["Admin_NoPending"]</p>
                    </div>
                }
                else
                {
                    <table class="cr-table">
                        <thead>
                            <tr><th>@L["Admin_Car"]</th><th>@L["Admin_User"]</th><th>@L["Admin_Dates"]</th><th class="text-end">@L["Admin_Actions"]</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.RecentPending)
                            {
                                <tr>
                                    <td class="cr-td-main"><div class="cr-td-title">@r.Car?.FullName</div><div class="cr-td-sub">@r.Car?.Location</div></td>
                                    <td data-label="@L["Admin_User"]"><div>@r.User?.UserName</div><div class="cr-td-sub">@r.User?.Email</div></td>
                                    <td data-label="@L["Admin_Dates"]"><div>@r.PickupDate?.ToString("dd MMM") – @r.ReturnDate?.ToString("dd MMM yyyy")</div><div class="cr-td-sub">@r.DurationDays @L["Rental_Days"] · @r.TotalPrice.ToString("N0") ₴</div></td>
                                    <td class="cr-td-actions">
                                        <form asp-action="ConfirmRental" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <button type="submit" class="btn btn-sm btn-success btn-icon" title="@L["Admin_Approve"]" aria-label="@L["Admin_Approve"]"><i class="bi bi-check-lg"></i></button>
                                        </form>
                                        <a asp-action="RejectRental" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger btn-icon" title="@L["Admin_Reject"]" aria-label="@L["Admin_Reject"]"><i class="bi bi-x-lg"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="cr-panel">
                <h2 class="cr-panel__title"><i class="bi bi-lightning"></i>@L["Admin_QuickActions"]</h2>
                <div class="cr-quick">
                    <a asp-action="CreateCar"><i class="bi bi-plus-circle"></i>@L["Admin_AddNewCar"]<i class="bi bi-chevron-right ms-auto"></i></a>
                    <a asp-action="Cars"><i class="bi bi-car-front"></i>@L["Admin_ManageAllCars"]<i class="bi bi-chevron-right ms-auto"></i></a>
                    <a asp-action="Rentals"><i class="bi bi-calendar-event"></i>@L["Admin_ReviewAllRentals"]<i class="bi bi-chevron-right ms-auto"></i></a>
                    <a asp-action="Users"><i class="bi bi-people"></i>@L["Admin_ManageUsers"]<i class="bi bi-chevron-right ms-auto"></i></a>
                </div>
            </div>

            <div class="cr-panel">
                <h2 class="cr-panel__title"><i class="bi bi-stars"></i>@L["Admin_AiTitle"]</h2>
                <form asp-action="SaveAiSettings" method="post" class="d-grid gap-3">
                    <div>
                        <label class="cr-label" for="aiModel">@L["Admin_AiModel"]</label>
                        <select id="aiModel" name="chatModel" class="form-select">
                            @foreach (var m in Model.AiModels)
                            {
                                var price = $"${m.InputPer1M.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)} / ${m.OutputPer1M.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}";
                                <option value="@m.Id" selected="@(m.Id.Equals(Model.ActiveAiModel, StringComparison.OrdinalIgnoreCase))">@m.Model · @price</option>
                            }
                        </select>
                        <div class="cr-td-sub mt-1">@L["Admin_AiModelHint"]</div>
                        <div class="cr-td-sub">@L["Admin_AiModelDefault"]: <code>@Model.DefaultAiModel</code></div>
                    </div>
                    @if (Model.RankingModels.Count > 0)
                    {
                        <div>
                            <label class="cr-label" for="rankingModel">@L["Admin_RankingModel"]</label>
                            <select id="rankingModel" name="rankingModel" class="form-select">
                                @foreach (var m in Model.RankingModels)
                                {
                                    var quality = m.TestNdcg5 is { } q ? " · NDCG@5 " + q.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture) : "";
                                    <option value="@m.Id" selected="@(m.Id == Model.ActiveRankingModel)">@L["Ranking_" + m.Id].Value@quality</option>
                                }
                            </select>
                            <div class="cr-td-sub mt-1">@L["Admin_RankingModelHint"]</div>
                        </div>
                    }
                    <div>
                        <label class="cr-label" for="searchMode">@L["Admin_AiSearch"]</label>
                        <select id="searchMode" name="searchMode" class="form-select">
                            @foreach (var m in Model.SearchModes)
                            {
                                <option value="@m" selected="@(m == Model.ActiveSearchMode)">@L["Search_" + m.ToString()].Value</option>
                            }
                        </select>
                        <div class="cr-td-sub mt-1">@L["Admin_SearchHint"]</div>
                    </div>
                    <button type="submit" class="btn btn-primary">@L["Admin_AiModelSave"]</button>
                </form>
            </div>
        </div>
    </div>
</div>
