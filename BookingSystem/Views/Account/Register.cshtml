@model RegisterViewModel
@{
    ViewData["Title"] = L["Account_Register_Title"].Value;
}

<div class="cr-auth" style="max-width: 520px;">
    <div class="cr-panel p-4 p-sm-5">
        <div class="cr-auth__logo"><i class="bi bi-person-plus"></i></div>
        <h1>@L["Account_CreateAccount"]</h1>
        <p class="cr-auth__sub">@L["Account_RegisterDesc"]</p>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <form asp-action="Register" method="post">
            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" placeholder="@L["Account_FirstNamePlaceholder"]" autocomplete="given-name" />
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" placeholder="@L["Account_LastNamePlaceholder"]" autocomplete="family-name" />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" placeholder="@L["Account_PasswordPlaceholder"]" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="@L["Account_RepeatPassword"]" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">@L["Account_CreateAccountBtn"]</button>
        </form>

        <p class="text-center cr-muted mt-4 mb-0">
            @L["Account_AlreadyHave"]
            <a asp-action="Login" class="fw-bold text-decoration-none">@L["Account_SignInLink"]</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
