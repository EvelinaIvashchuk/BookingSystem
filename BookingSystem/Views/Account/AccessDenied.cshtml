@{
    ViewData["Title"] = L["Account_AccessDenied_Title"].Value;
}

<div class="cr-panel cr-empty mt-4">
    <div class="cr-empty__icon" style="background:#FCEBEB;color:#A32D2D;"><i class="bi bi-shield-lock"></i></div>
    <h2>@L["Account_AccessDenied_Title"]</h2>
    <p>@L["Account_AccessDeniedDesc"]</p>
    <div class="d-flex justify-content-center flex-wrap gap-2">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4"><i class="bi bi-house me-1"></i>@L["Account_GoHome"]</a>
        @if (User.Identity?.IsAuthenticated != true)
        {
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary px-4"><i class="bi bi-box-arrow-in-right me-1"></i>@L["Account_SignInLink2"]</a>
        }
    </div>
</div>
