@model LoginViewModel
@{
    ViewData["Title"] = L["Account_SignIn_Title"].Value;
}

<div class="cr-auth">
    <div class="cr-panel p-4 p-sm-5">
        <div class="cr-auth__logo"><i class="bi bi-stars"></i></div>
        <h1>@L["Account_WelcomeBack"]</h1>
        <p class="cr-auth__sub">@L["Account_SignInDesc"]</p>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control form-control-lg" placeholder="you@example.com" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control form-control-lg" placeholder="••••••••" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label cr-muted">@L["Account_RememberMe"]</label>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">@L["Account_SignInBtn"]</button>
        </form>

        <p class="text-center cr-muted mt-4 mb-0">
            @L["Account_NoAccount"]
            <a asp-action="Register" class="fw-bold text-decoration-none">@L["Account_CreateOne"]</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
