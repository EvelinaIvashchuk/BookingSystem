@using BookingSystem.Helpers
@using Microsoft.AspNetCore.Mvc.Rendering
@model PaginatedList<BookingSystem.Models.Car>
@{
    ViewData["Title"] = L["Car_Title"].Value;
    var categories = (ViewBag.Categories as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>()).ToList();
    var search = (string?)ViewBag.Search;
    var categoryId = ViewBag.CategoryId?.ToString() as string;
    var filtered = !string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(categoryId);
}

<div class="cr-page">
    <div class="cr-page-head">
        <div>
            <h1>@L["Car_BrowseCars"]</h1>
            <p>@string.Format(L["Car_CarsFound"].Value, Model.TotalCount)</p>
        </div>
        <button type="button" class="btn btn-outline-primary" onclick="window.CarRentalChat && window.CarRentalChat.open()">
            <i class="bi bi-stars me-1"></i>@L["Car_AskAssistant"]
        </button>
    </div>

    <div class="cr-panel cr-filters mb-4">
        <form asp-action="Index" method="get" class="cr-filters__search">
            @if (!string.IsNullOrEmpty(categoryId))
            {
                <input type="hidden" name="categoryId" value="@categoryId" />
            }
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="text" name="search" value="@search" class="form-control" placeholder="@L["Car_SearchPlaceholder"]" aria-label="@L["Car_SearchPlaceholder"]" />
            <button type="submit" class="btn btn-primary">@L["Car_Search"]</button>
        </form>
        <div class="cr-filters__chips">
            <a asp-action="Index" asp-route-search="@search" class="cr-filter-chip @(string.IsNullOrEmpty(categoryId) ? "is-active" : "")">@L["Car_AllCategories"]</a>
            @foreach (var c in categories)
            {
                <a asp-action="Index" asp-route-categoryId="@c.Value" asp-route-search="@search" class="cr-filter-chip @(c.Value == categoryId ? "is-active" : "")">@c.Text</a>
            }
            @if (filtered)
            {
                <a asp-action="Index" class="cr-filter-reset"><i class="bi bi-x-lg me-1"></i>@L["Car_ResetFilters"]</a>
            }
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="cr-panel cr-empty">
            <div class="cr-empty__icon"><i class="bi bi-search"></i></div>
            <h2>@L["Car_NoResults"]</h2>
            <p>@L["Car_NoResultsHint"]</p>
            <a asp-action="Index" class="btn btn-primary">@L["Car_ViewAllCars"]</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
            @foreach (var c in Model)
            {
                <div class="col">
                    <div class="cr-car">
                        <a asp-action="Details" asp-route-id="@c.Id" tabindex="-1" aria-hidden="true">
                            @if (!string.IsNullOrEmpty(c.ImageUrl))
                            {
                                <img src="@ImageHelper.Src(c.ImageUrl)" class="cr-car__img" alt="" loading="lazy">
                            }
                            else
                            {
                                <div class="cr-car__img d-flex align-items-center justify-content-center fs-1 cr-muted"><i class="bi bi-car-front"></i></div>
                            }
                        </a>
                        <div class="cr-car__body">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <span class="cr-car__cat">@c.Category?.Name</span>
                                <span class="cr-muted small text-truncate"><i class="bi bi-geo-alt me-1"></i>@c.Location.Split(',')[0]</span>
                            </div>
                            <h2 class="cr-car__name"><a asp-action="Details" asp-route-id="@c.Id" class="text-reset text-decoration-none">@c.FullName</a></h2>
                            <div class="cr-car__specs">
                                <span><i class="bi bi-fuel-pump me-1"></i>@L["Enum_" + c.FuelType]</span>
                                <span><i class="bi bi-gear me-1"></i>@L["Enum_" + c.Transmission]</span>
                                <span><i class="bi bi-people me-1"></i>@c.Seats</span>
                            </div>
                            <div class="cr-car__foot">
                                <div class="cr-car__price">@c.PricePerDay.ToString("N0") ₴ <span>@L["Car_PerDayShort"]</span></div>
                                <a asp-controller="Rental" asp-action="Create" asp-route-carId="@c.Id" class="btn btn-sm btn-primary">@L["Car_RentNow"]</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        ViewData["PageIndex"]  = Model.PageIndex;
        ViewData["TotalPages"] = Model.TotalPages;
        ViewData["Action"]     = "Index";
        ViewData["RouteValues"] = new Dictionary<string, string>
        {
            ["search"]     = ViewBag.Search ?? "",
            ["categoryId"] = ViewBag.CategoryId?.ToString() ?? ""
        };
        <partial name="_Pagination" />
    }
</div>
