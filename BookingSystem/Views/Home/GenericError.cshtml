@{
    ViewData["Title"] = L["Error_Generic_Title"].Value;
    var code = ViewBag.StatusCode as int? ?? 500;
}

<div class="cr-panel cr-empty mt-4">
    <div class="cr-error-code">@code</div>
    <h2>@L["Error_Generic_Desc"]</h2>
    <p>@L["Error_Generic_Details"]</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4"><i class="bi bi-house me-1"></i>@L["Common_GoHome"]</a>
</div>
