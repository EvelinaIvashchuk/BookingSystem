@using BookingSystem.Helpers
@model IEnumerable<Car>
@{
    ViewData["Title"] = L["Home_Title"].Value;
    var chips = new[] { L["Home_AiChip1"].Value, L["Home_AiChip2"].Value, L["Home_AiChip3"].Value, L["Home_AiChip4"].Value };
}

@* ─── HERO: the assistant is the main entry point ─────────────────────── *@
<section class="cr-hero">
    <span class="cr-eyebrow"><i class="bi bi-stars"></i>@L["Home_AiEyebrow"]</span>
    <h1>@L["Home_AiTitle"]</h1>
    <p class="cr-lead">@L["Home_AiSubtitle"]</p>

    <form class="cr-ask" id="cr-ask" autocomplete="off">
        <i class="bi bi-stars" aria-hidden="true"></i>
        <input id="cr-ask-input" type="text" maxlength="1000" placeholder="@L["Home_AiPlaceholder"]" aria-label="@L["Home_AiPlaceholder"]" />
        <button type="submit"><i class="bi bi-send-fill me-1"></i><span>@L["Home_AiAsk"]</span></button>
    </form>

    <div class="cr-chips">
        @foreach (var chip in chips)
        {
            <button type="button" class="cr-chip" data-ask="@chip">@chip</button>
        }
    </div>

    <div class="cr-alt">
        @L["Home_AiOr"] <a asp-controller="Car" asp-action="Index">@L["Home_BrowseCars"] <i class="bi bi-arrow-right"></i></a>
    </div>
</section>

<div class="container">
    @* ─── HOW IT WORKS ─────────────────────────────────────────────────── *@
    <h2 class="cr-section-title">@L["Home_HowItWorks"]</h2>
    <p class="cr-section-sub">@L["Home_HowItWorksSub"]</p>
    <div class="cr-steps">
        <div class="cr-step">
            <div class="cr-step__num">1</div>
            <h3>@L["Home_Step1Title"]</h3>
            <p>@L["Home_Step1Desc"]</p>
        </div>
        <div class="cr-step">
            <div class="cr-step__num">2</div>
            <h3>@L["Home_Step2Title"]</h3>
            <p>@L["Home_Step2Desc"]</p>
        </div>
        <div class="cr-step">
            <div class="cr-step__num">3</div>
            <h3>@L["Home_Step3Title"]</h3>
            <p>@L["Home_Step3Desc"]</p>
        </div>
    </div>

    @* ─── POPULAR CARS ─────────────────────────────────────────────────── *@
    @if (Model.Any())
    {
        <div class="d-flex justify-content-between align-items-end mb-3">
            <div>
                <h2 class="cr-section-title">@L["Home_PopularCars"]</h2>
                <p class="cr-section-sub mb-0">@L["Home_PopularCarsSub"]</p>
            </div>
            <a asp-controller="Car" asp-action="Index" class="btn btn-outline-primary btn-sm px-3">
                @L["Home_ViewAll"] <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3 mb-5">
            @foreach (var c in Model.Take(6))
            {
                <div class="col">
                    <a asp-controller="Car" asp-action="Details" asp-route-id="@c.Id" class="cr-car text-decoration-none text-reset">
                        @if (!string.IsNullOrEmpty(c.ImageUrl))
                        {
                            <img src="@ImageHelper.Src(c.ImageUrl)" class="cr-car__img" alt="@c.FullName" loading="lazy">
                        }
                        else
                        {
                            <div class="cr-car__img d-flex align-items-center justify-content-center text-secondary fs-1"><i class="bi bi-car-front"></i></div>
                        }
                        <div class="cr-car__body">
                            <span class="cr-car__cat">@c.Category?.Name</span>
                            <h3 class="cr-car__name">@c.FullName</h3>
                            <div class="cr-car__specs">
                                <span><i class="bi bi-fuel-pump me-1"></i>@c.FuelType</span>
                                <span><i class="bi bi-gear me-1"></i>@c.Transmission</span>
                                <span><i class="bi bi-people me-1"></i>@c.Seats</span>
                            </div>
                            <div class="cr-car__foot">
                                <div class="cr-car__price">@c.PricePerDay.ToString("N0") ₴ <span>@L["Car_PerDayShort"]</span></div>
                                <span class="btn btn-sm btn-outline-primary">@L["Home_ViewDetails"]</span>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            // The hero input and the suggestion chips open the chat widget and send the text as the first message.
            function ask(text) {
                text = (text || '').trim();
                if (!text) return;
                if (window.CarRentalChat) window.CarRentalChat.ask(text);
            }
            document.getElementById('cr-ask').addEventListener('submit', function (e) {
                e.preventDefault();
                const input = document.getElementById('cr-ask-input');
                ask(input.value);
                input.value = '';
            });
            document.querySelectorAll('.cr-chip').forEach(function (chip) {
                chip.addEventListener('click', function () { ask(chip.dataset.ask); });
            });
        })();
    </script>
}
