{
  "Ai": {
    "DefaultModel": "groq:openai/gpt-oss-120b",
    "MaxAgentIterations": 5,
    "Temperature": 0.2,
    "MaxOutputTokens": 1024,
    "HistoryLength": 12,
    "MaxMessageLength": 1000,
    "TimeZone": "Europe/Kyiv",
    "PendingActionTtlMinutes": 15,
    "SlotFilling": {
      "Enabled": true
    },
    "KnowledgeBase": {
      "Path": "KnowledgeBase",
      "IndexOnStartup": true,
      "MaxChunkTokens": 350,
      "EmbeddingBatchSize": 50
    },
    "Search": {
      "Mode": "HybridAdaptive",
      "TopK": 3,
      "Candidates": 20,
      "RrfK": 60,
      "Adaptive": { "A": 0.45, "B": 0.40, "C": 0.05, "N0": 4, "E": 0.10, "Beta": 0.25, "MinWeight": 0.15, "MaxWeight": 0.85 }
    },
    "Providers": {
      "groq": {
        "Endpoint": "https://api.groq.com/openai/v1",
        "ApiKey": ""
      },
      "gemini": {
        "Endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/",
        "ApiKey": ""
      }
    },
    "Embedding": {
      "Provider": "gemini",
      "Model": "gemini-embedding-001"
    },
    "Pricing": [
      {
        "Model": "groq:openai/gpt-oss-120b",
        "InputPer1M": 0,
        "OutputPer1M": 0
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=CarRentalDb;User=root;Password=12345678;AllowPublicKeyRetrieval=True;SslMode=Preferred;"
  },
  "Seed": {
    "AdminEmail": "admin@carrental.local",
    "AdminPassword": "Admin@12345"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
