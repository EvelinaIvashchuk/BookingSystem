{
  "Ai": {
    "DefaultModel": "gemini:gemini-3.6-flash",
    "MaxAgentIterations": 5,
    "Temperature": 0.2,
    "MaxOutputTokens": 1024,
    "HistoryLength": 12,
    "MaxMessageLength": 1000,
    "TimeZone": "Europe/Kyiv",
    "PendingActionTtlMinutes": 15,
    "RateLimit": {
      "Enabled": true,
      "PerIpPerMinute": 20,
      "PerSessionPerHour": 60
    },
    "SlotFilling": {
      "Enabled": true,
      "RequireGroundedDates": true
    },
    "KnowledgeBase": {
      "Path": "KnowledgeBase",
      "IndexOnStartup": true,
      "MaxChunkTokens": 350,
      "EmbeddingBatchSize": 50
    },
    "Search": {
      "Mode": "Vector",
      "TopK": 3,
      "Candidates": 20,
      "RrfK": 60,
      "Adaptive": {
        "A": 0.3,
        "B": 0.4,
        "C": 0.3,
        "N0": 2,
        "E": 0.1,
        "Beta": 0.3,
        "MinWeight": 0.05,
        "MaxWeight": 0.85
      }
    },
    "Providers": {
      "groq": {
        "Endpoint": "https://api.groq.com/openai/v1",
        "ApiKey": ""
      },
      "gemini": {
        "Endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/",
        "ApiKey": ""
      }
    },
    "Embedding": {
      "Provider": "gemini",
      "Model": "gemini-embedding-001"
    },
    "Pricing": [
      {
        "Model": "gemini:gemini-3.6-flash",
        "InputPer1M": 0.75,
        "OutputPer1M": 3.75
      },
      {
        "Model": "groq:openai/gpt-oss-120b",
        "InputPer1M": 0,
        "OutputPer1M": 0
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=CarRentalDb;User=root;Password=12345678;AllowPublicKeyRetrieval=True;SslMode=Preferred;"
  },
  "Seed": {
    "AdminEmail": "admin@carrental.local",
    "AdminPassword": "Admin@12345"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
